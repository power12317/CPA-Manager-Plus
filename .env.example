# Optional settings. Copy to .env; never commit .env or real keys.
CPAMP_BIND_ADDRESS=0.0.0.0
CPAMP_PORT=18317
# Leave empty to generate a key on first startup (read docker compose logs).
CPA_MANAGER_ADMIN_KEY=
# Only set when Nginx retains the prefix; leave empty when it strips the prefix.
CPA_MANAGER_BASE_PATH=
USAGE_COLLECTOR_MODE=auto
# Independent experiment image; latest and sha-<full commit> tags are published.
CPAMP_IMAGE=ghcr.io/power12317/cpa-manager-plus-oailb-borrow:latest
